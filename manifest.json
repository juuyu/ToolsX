{
  "manifest_version": 3,
  "name": "Tools-X · Docs / JSON / Postman",
  "version": "1.1.0",
  "description": "Docs 多级目录笔记、JSON 工具与 Postman HTTP 请求调试，纯浏览器运行，数据保存在本地，无需后端服务。",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Tools-X"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage", "unlimitedStorage", "clipboardWrite"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "content_scripts": [
    {
      "matches": ["file:///*"],
      "js": ["core/md-core.js", "preview/shell.js", "preview/md-page.js", "preview/json-page.js"],
      "css": ["core/theme.css", "core/markdown.css", "preview/shell.css", "preview/json-page.css"],
      "all_frames": false
    }
  ],
  "sandbox": {
    "pages": ["app.html"]
  }
}
